---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '全网 AI 资讯每日精选：模型发布、产品更新、行业动态，每天一期。' } = Astro.props;
import '../styles/global.css';
import { withBase } from '../lib/url';

// 导航当前页判定（兼容 base 路径与结尾斜杠差异）
const baseTrim = withBase('/').replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/index\.html$/, '').replace(/\/$/, '');
const cur = (p: string) => (path === (p === '/' ? baseTrim : baseTrim + p) ? 'page' : undefined);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="AI 日报" href={withBase('/rss.xml')} />
    <script is:inline>
      // 主题初始化要在首帧渲染前执行，避免闪白（FOUC）
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'dark' && t !== 'light') {
            t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={withBase('/')}>AI<em>日报</em></a>
        <nav class="site-nav">
          <a href={withBase('/')} aria-current={cur('/')}>本期</a>
          <a href={withBase('/hot')} aria-current={cur('/hot')}>热榜</a>
          <a href={withBase('/all')} aria-current={path.startsWith(baseTrim + '/all') ? 'page' : undefined}>全部</a>
          <a href={withBase('/archive')} aria-current={cur('/archive')}>往期</a>
          <a href={withBase('/search')} aria-current={cur('/search')}>搜索</a>
          <button class="theme-toggle" id="theme-toggle" type="button" title="切换明暗主题" aria-label="切换明暗主题">
            <span class="ico-moon">☾</span><span class="ico-sun">☀</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <span>内容由 LLM 自动采集加工，版权归原作者所有 · 本站仅做摘要与链接</span>
        <span>
          <a href={withBase('/archive')}>往期归档</a>
          · <a href={withBase('/rss.xml')}>RSS 订阅</a>
        </span>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
