---
// /daily = 最新一期日报（AIHOT report-latest）
import Layout from '../../layouts/Layout.astro';
import ReportPaper from '../../components/report/ReportPaper.astro';
import { getDailyIndex, getDailyPaper } from '../../lib/reports';

const latest = getDailyIndex()[0];
const paper = latest ? getDailyPaper(latest.key) : null;
---

<Layout
  title={paper ? `AI 日报 · 第 ${paper.issueNo} 期 · ${paper.key}` : 'AI 日报'}
  description={paper?.leadParagraph ?? undefined}
  report="daily"
  reportKey={paper?.key ?? ''}
>
  {paper ? (
    <div data-pagefind-body>
      <ReportPaper paper={paper} />
      <span hidden data-pagefind-meta="title">{`AI 日报 · 第 ${paper.issueNo} 期 · ${paper.key}`}</span>
    </div>
  ) : (
    <div class="empty-tip">
      还没有生成任何日报。<br />
      在项目根目录运行 <code>python -m collector.pipeline</code> 生成第一期。
    </div>
  )}
</Layout>
