---
import Layout from '../../layouts/Layout.astro';
import ReportPaper from '../../components/report/ReportPaper.astro';
import { getDailyIndex, getDailyPaper } from '../../lib/reports';

export function getStaticPaths() {
  return getDailyIndex().map((e) => {
    const paper = getDailyPaper(e.key)!;
    return { params: { date: e.key }, props: { paper } };
  });
}

const { paper } = Astro.props;
---

<Layout
  title={`AI 日报 · 第 ${paper.issueNo} 期 · ${paper.key}`}
  description={paper.leadParagraph ?? undefined}
  report="daily"
  reportKey={paper.key}
>
  <div data-pagefind-body>
    <ReportPaper paper={paper} />
    <span hidden data-pagefind-meta="title">{`AI 日报 · 第 ${paper.issueNo} 期 · ${paper.key}`}</span>
  </div>
</Layout>
