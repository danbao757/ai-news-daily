---
import Layout from '../../layouts/Layout.astro';
import AllFeed from '../../components/AllFeed.astro';
import { getItemIndex } from '../../lib/issues';

export function getStaticPaths() {
  const idx = getItemIndex();
  const months = [...new Set([...idx.values()].map((it) => (it.date ?? '').slice(0, 7)))]
    .filter(Boolean).sort((a, b) => b.localeCompare(a));
  return months.map((month) => ({
    params: { month },
    props: {
      items: [...idx.values()].filter((it) => (it.date ?? '').startsWith(month)),
      months,
    },
  }));
}

const { items, months } = Astro.props;
const month = Astro.params.month!;
---

<Layout title={`全部动态 · ${month} · AI 日报`} wide>
  <header class="page-head">
    <h1>全部动态</h1>
    <span class="ph-sub">{month} · <b>{items.length}</b> 条 · 含未精选</span>
  </header>
  <AllFeed items={items} month={month} months={months} />
</Layout>
