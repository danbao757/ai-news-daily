---
import Layout from '../../layouts/Layout.astro';
import IssueMasthead from '../../components/IssueMasthead.astro';
import IssueView from '../../components/IssueView.astro';
import SideStats from '../../components/SideStats.astro';
import SideHot from '../../components/SideHot.astro';
import SideCats from '../../components/SideCats.astro';
import { getIssues } from '../../lib/issues';

export function getStaticPaths() {
  return getIssues().map((issue) => ({
    params: { date: issue.date },
    props: { issue },
  }));
}

const { issue } = Astro.props;
---

<Layout title={`AI 日报 · 第 ${issue.issue} 期 · ${issue.date}`}>
  <div data-pagefind-body>
    <IssueMasthead issue={issue} />
    <div class="layout-cols">
      <div class="main-col">
        <IssueView issue={issue} />
      </div>
      <aside class="side-col">
        <SideStats issue={issue} />
        <SideHot date={issue.date} />
        <SideCats date={issue.date} />
      </aside>
    </div>
    <span hidden data-pagefind-meta="title">{`AI 日报 · 第 ${issue.issue} 期 · ${issue.date}`}</span>
  </div>
</Layout>
