---
import type { Issue } from '../lib/issues';
import { getEventById } from '../lib/issues';
import { withBase } from '../lib/url';
import CategoryChip from './CategoryChip.astro';

interface Props { issue: Issue }
const { issue } = Astro.props;

// 评分刻度：5 格，每格 20 分；tier 色随分数档位；未评分（评分调用失败）不显示
const ticks = (score: number) => Math.max(1, Math.min(5, Math.round(score / 20)));
const tier = (score: number) =>
  score >= 90 ? 't90' : score >= 75 ? 't75' : score >= 60 ? 't60' : 't40';
const hasScore = (s: number | null): s is number => typeof s === 'number';

// 多源事件才有事件页
const storyHref = (eid: string | null) => {
  if (!eid) return null;
  const ev = getEventById(eid);
  return ev && ev.source_count >= 2 ? withBase(`/story/${eid}/`) : null;
};

// 导语「今日看点」引用的条目（按 id 查回）
const byId = new Map([...issue.headlines, ...issue.briefing].map((it) => [it.id, it]));
const highlightItems = (issue.lead?.highlights ?? [])
  .map((id) => byId.get(id))
  .filter(Boolean);
---

{issue.lead && (issue.lead.title || issue.lead.paragraph || highlightItems.length > 0) && (
  <div class="lead-block" data-pagefind-ignore>
    {issue.lead.title && <div class="lead-title">{issue.lead.title}</div>}
    {issue.lead.paragraph && <p>{issue.lead.paragraph}</p>}
    {highlightItems.length > 0 && (
      <ul class="highlights">
        {highlightItems.map((it) => (
          <li><a href={`#item-${it!.id}`} title={it!.title_zh}>{it!.title_zh.slice(0, 24)}</a></li>
        ))}
      </ul>
    )}
  </div>
)}

{issue.headlines.length > 0 && (
  <div class="section-title" data-pagefind-ignore>头条 <span class="en">Top Stories</span></div>
)}
<div class="headlines">
  {issue.headlines.map((item) => {
    const story = storyHref(item.event_id);
    return (
      <article class="headline-card" id={`item-${item.id}`}>
        <div class="row-top" data-pagefind-ignore>
          <CategoryChip category={item.category} />
          {item.first_party && <span class="tag">官方一手</span>}
          {item.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
        </div>
        <h2><a href={item.url} target="_blank" rel="noopener">{item.title_zh || item.title_orig}</a></h2>
        {item.summary_zh && <p>{item.summary_zh}</p>}
        {item.reason_zh && <div class="reason">{item.reason_zh}</div>}
        <div class="row-bottom" data-pagefind-ignore>
          {hasScore(item.score) ? (
            <span class="s-label">AI 评分</span>
          ) : ''}
          {hasScore(item.score) && (
            <span class={`score-meter ${tier(item.score)}`} title="AI 评分 {item.score} / 100">
              {[0, 1, 2, 3, 4].map((i) => <i class={i < ticks(item.score) ? 'on' : ''}></i>)}
              <b>{item.score}</b>
            </span>
          )}
          {hasScore(item.score) && <span class="dot" aria-hidden="true">·</span>}
          <a class="src" href={item.url} target="_blank" rel="noopener">{item.source} <span class="arrow">↗</span></a>
          {story && (
            <>
              <span class="dot" aria-hidden="true">·</span>
              <a class="story-link" href={story}>事件脉络 →</a>
            </>
          )}
        </div>
      </article>
    );
  })}
</div>

{issue.briefing.length > 0 && (
  <div class="section-title" data-pagefind-ignore>速览 <span class="en">Briefing</span></div>
)}
<ul class="brief-list">
  {issue.briefing.map((item) => (
    <li id={`item-${item.id}`}>
      <span class={`score ${hasScore(item.score) ? tier(item.score) : ''}`} data-pagefind-ignore>
        {hasScore(item.score) ? item.score : '—'}
        {hasScore(item.score) && (
          <span class="mini-meter">
            {[0, 1, 2, 3, 4].map((i) => <i class={i < ticks(item.score) ? 'on' : ''}></i>)}
          </span>
        )}
      </span>
      <div class="body">
        <span class="t"><a href={item.url} target="_blank" rel="noopener">{item.title_zh || item.title_orig}</a></span>
        <CategoryChip category={item.category} />
        <span class="sub" data-pagefind-ignore><a href={item.url} target="_blank" rel="noopener">{item.source} ↗</a></span>
      </div>
    </li>
  ))}
</ul>
