---
import type { Issue } from '../lib/issues';
import { fmtDate } from '../lib/issues';
import CategoryChip from './CategoryChip.astro';

interface Props { issue: Issue }
const { issue } = Astro.props;

// 评分刻度：5 格，每格 20 分；tier 色随分数档位
const ticks = (score: number) => Math.max(1, Math.min(5, Math.round(score / 20)));
const tier = (score: number) =>
  score >= 90 ? 't90' : score >= 75 ? 't75' : score >= 60 ? 't60' : 't40';
---

<section class="masthead">
  <div class="mast-rule" data-pagefind-ignore></div>
  <div class="mast-body">
    <div class="mast-main">
      <div class="kicker">Daily Briefing</div>
      <h1>AI 日报</h1>
    </div>
    <div class="issue-no" data-pagefind-ignore>第 {issue.issue} 期</div>
  </div>
  <div class="mast-meta" data-pagefind-ignore>
    <span class="date">{fmtDate(issue.date)}</span>
    <span class="sep" aria-hidden="true"></span>
    <span>收录 {issue.stats.selected} 条 · 采集 {issue.stats.collected} · 去重 {issue.stats.duplicates}</span>
  </div>
</section>

{issue.headlines.length > 0 && (
  <div class="section-title" data-pagefind-ignore>头条 <span class="en">Top Stories</span></div>
)}
<div class="headlines">
  {issue.headlines.map((item) => (
    <article class="headline-card">
      <div class="row-top" data-pagefind-ignore>
        <CategoryChip category={item.category} />
        {item.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <h2><a href={item.url} target="_blank" rel="noopener">{item.title_zh}</a></h2>
      {item.summary_zh && <p>{item.summary_zh}</p>}
      <div class="row-bottom" data-pagefind-ignore>
        <span class="s-label">AI 评分</span>
        <span class={`score-meter ${tier(item.score)}`} title="AI 评分 {item.score} / 100">
          {[0, 1, 2, 3, 4].map((i) => <i class={i < ticks(item.score) ? 'on' : ''}></i>)}
          <b>{item.score}</b>
        </span>
        <span class="dot" aria-hidden="true">·</span>
        <a class="src" href={item.url} target="_blank" rel="noopener">{item.source} <span class="arrow">↗</span></a>
      </div>
    </article>
  ))}
</div>

{issue.briefing.length > 0 && (
  <div class="section-title" data-pagefind-ignore>速览 <span class="en">Briefing</span></div>
)}
<ul class="brief-list">
  {issue.briefing.map((item) => (
    <li>
      <span class={`score ${tier(item.score)}`} data-pagefind-ignore>
        {item.score}
        <span class="mini-meter">
          {[0, 1, 2, 3, 4].map((i) => <i class={i < ticks(item.score) ? 'on' : ''}></i>)}
        </span>
      </span>
      <div class="body">
        <span class="t"><a href={item.url} target="_blank" rel="noopener">{item.title_zh}</a></span>
        <CategoryChip category={item.category} />
        <span class="sub" data-pagefind-ignore><a href={item.url} target="_blank" rel="noopener">{item.source} ↗</a></span>
      </div>
    </li>
  ))}
</ul>
