---
// /all 全部动态（参照 AIHOT all + DayList）：顶部筛选胶囊行 + 按日时间线 + 月份导航
// 纯客户端过滤；?cat= / ?tag= / ?sel= / ?first= 预激活由 FeedFilters 处理
import type { NewsItem } from '../lib/issues';
import FeedFilters from './FeedFilters.astro';
import DayTimeline from './DayTimeline.astro';
import { withBase } from '../lib/url';

interface Props {
  items: NewsItem[];       // 当月全部条目（含未精选）
  month: string;           // 当前月 YYYY-MM
  months: string[];        // 全部月份（降序）
}
const { items, month, months } = Astro.props;

const pos = months.indexOf(month);
const prevMonth = pos >= 0 && pos + 1 < months.length ? months[pos + 1] : null;
const nextMonth = pos > 0 ? months[pos - 1] : null;
---

<div class="feed-page">
  <FeedFilters items={items} showSel />
  <div data-pagefind-body>
    <DayTimeline items={items} showTags />
  </div>

  <div class="month-nav" data-pagefind-ignore>
    {prevMonth
      ? <a href={withBase(`/all/${prevMonth}/`)}>← {prevMonth}</a>
      : <span></span>}
    <span class="cur">{month} · {months.length} 个月</span>
    {nextMonth
      ? <a href={withBase(`/all/${nextMonth}/`)}>{nextMonth} →</a>
      : <span></span>}
  </div>
</div>
