---
import { CATEGORY_LABELS, getItemIndex } from '../lib/issues';
import { withBase } from '../lib/url';

// 侧栏「今日分类」卡：当日各分类条目数，点击跳 /all
interface Props { date: string }
const { date } = Astro.props;
const items = [...getItemIndex().values()].filter((it) => it.date === date);
const counts = new Map<string, number>();
for (const it of items) {
  const k = it.category ?? '';
  counts.set(k, (counts.get(k) ?? 0) + 1);
}
const ordered = [...counts.entries()]
  .sort((a, b) => b[1] - a[1])
  .filter(([k]) => k === '' || CATEGORY_LABELS[k]);
---

{items.length > 0 && (
  <div class="side-card" data-pagefind-ignore>
    <h3 class="side-title">今日分类 <span class="en">Topics</span></h3>
    <nav class="cat-rows">
      <a href={withBase('/all')}>
        全部 <b>{items.length}</b>
      </a>
      {ordered.map(([k, n]) => (
        <a href={k ? withBase('/all') + '?cat=' + k : withBase('/all')}>
          {k ? CATEGORY_LABELS[k] : '资讯'} <b>{n}</b>
        </a>
      ))}
    </nav>
  </div>
)}
