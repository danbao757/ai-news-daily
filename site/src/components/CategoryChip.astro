---
import { CATEGORY_LABELS } from '../lib/issues';

// category 是 collector/taxonomy.py 的 key（ai-models 等）；未知 key 落到通用样式
interface Props { category: string | null }
const { category } = Astro.props;
const key = category && CATEGORY_LABELS[category] ? category : null;
const label = key ? CATEGORY_LABELS[key] : '资讯';
---

<span class={`chip ${key ? `cat-${key}` : ''}`} data-pagefind-ignore>{label}</span>
